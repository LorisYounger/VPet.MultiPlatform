<Project Sdk="Microsoft.NET.Sdk">

	<!-- Avalonia 宿主直接编译 Windows.Interface 的共享源码，代码 MOD 通过 Unified 契约访问宿主。 -->

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VPet_Simulator.MutiPlatform</RootNamespace>
		<AssemblyName>VPet-Simulator.MutiPlatform</AssemblyName>
		<Nullable>enable</Nullable>
        <DefineConstants>$(DefineConstants);VPET_AVALONIA</DefineConstants>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<!-- Steam 原生绑定随发布目标选择; 未指定 RID 时按当前系统构建, Windows 只支持 x64. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
		<PlatformTarget Condition="'$(RuntimeIdentifier)' != 'osx-arm64'">x64</PlatformTarget>
		<PlatformTarget Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">ARM64</PlatformTarget>
		<SteamworksBinding Condition="'$(RuntimeIdentifier)' == 'win-x64'">Win64</SteamworksBinding>
		<SteamworksBinding Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'">Posix</SteamworksBinding>
		<OsslSignCodeDirectory Condition="'$(OsslSignCodeDirectory)' == ''">$(MSBuildProjectDirectory)/Lib/osslsigncode/$(RuntimeIdentifier)</OsslSignCodeDirectory>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="mklink.bat" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Simple" Version="12.1.1" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

	<!-- 按发布目标选择 Facepunch.Steamworks 绑定和原生库。 -->
	<ItemGroup>
		<Reference Include="Facepunch.Steamworks.$(SteamworksBinding)" Condition="'$(SteamworksBinding)' != ''">
			<HintPath>Lib/Steamworks/2.5.2/net6.0/Facepunch.Steamworks.$(SteamworksBinding).dll</HintPath>
			<Private>true</Private>
		</Reference>
		<None Update="Lib/Steamworks/2.5.2/runtimes/win-x64/steam_api64.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Lib/Steamworks/2.5.2/runtimes/linux-x64/libsteam_api.so" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" Link="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Lib/Steamworks/2.5.2/runtimes/osx/libsteam_api.dylib" Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'" Link="libsteam_api.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="ValidateSteamworksPlatform" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(SteamworksBinding)' == '' or '$(Platform)' == 'x86' or '$(PlatformTarget)' == 'x86'" Text="Steamworks 支持 win-x64、linux-x64、osx-x64 和 osx-arm64。请用 -r 指定其中一个目标，并使用对应的 CPU 架构。" />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\VPet_Simulator.Core.MutiPlatform\VPet_Simulator.Core.MutiPlatform.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\VPet-Simulator.Windows.Interface\Base\**\*.cs" LinkBase="Interface\Base" />
		<!-- 共享源码中的 Translate() 通过下方的全局 using 使用跨平台翻译库。 -->
		<Compile Include="$(VPetRoot)/VPet-Simulator.Windows.Interface/Statistics.cs" Link="Interface/Base/Save/Statistics.cs" />
		<Compile Include="$(VPetRoot)/VPet-Simulator.Windows.Interface/PetActivity.cs" Link="Interface/Base/Effects/PetActivity.cs" />
		<Using Include="LinePutScript.Localization" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="vpeticon.ico" />
		<AvaloniaResource Include="Res/remixicon.ttf" />
		<AvaloniaResource Include="Res/**/*.png" />
	</ItemGroup>

  <ItemGroup>
    <Compile Include="$(VPetRoot)/VPet-Simulator.Windows/Function/UnifiedItemRegistry.Registration.cs" Link="Function/UnifiedItemRegistry.Registration.cs" />
    <Compile Include="$(VPetRoot)/VPet-Simulator.Windows/Function/UnifiedMPHost.cs" Link="Function/UnifiedMPHost.cs" />
    <Compile Include="$(VPetRoot)/VPet-Simulator.Windows/Function/UnifiedPluginHost.Wrappers.cs" Link="Function/UnifiedPluginHost.Wrappers.cs" />
    <Compile Include="$(VPetRoot)/VPet-Simulator.Windows/Function/WorkshopVerificationClient.cs" Link="Function/WorkshopVerificationClient.cs" />
    <EmbeddedResource Include="Lib/osslsigncode/certs/microsoft-root-2010.pem" LogicalName="Authenticode.microsoft-root-2010.pem" />
    <EmbeddedResource Include="Lib/osslsigncode/certs/microsoft-root-2011.pem" LogicalName="Authenticode.microsoft-root-2011.pem" />
    <Content Include="$(OsslSignCodeDirectory)/**/*" Link="tools/osslsigncode/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Lib/osslsigncode/notices/**/*" Link="tools/osslsigncode/notices/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Lib/osslsigncode/sources/**/*" Link="tools/osslsigncode/sources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateBundledOsslSignCode" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <OsslSignCodeName Condition="'$(RuntimeIdentifier)' == 'win-x64'">osslsigncode.exe</OsslSignCodeName>
      <OsslSignCodeName Condition="'$(RuntimeIdentifier)' != 'win-x64'">osslsigncode</OsslSignCodeName>
    </PropertyGroup>
    <Error Condition="!Exists('$(OsslSignCodeDirectory)/$(OsslSignCodeName)')" Text="缺少 $(RuntimeIdentifier) 内置 osslsigncode：$(OsslSignCodeDirectory)/$(OsslSignCodeName)" />
  </Target>

  <Target Name="MakeBundledOsslSignCodeExecutable" AfterTargets="CopyFilesToOutputDirectory" Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(RuntimeIdentifier)' != 'win-x64'">
    <Exec Command="chmod +x &quot;$(TargetDir)tools/osslsigncode/osslsigncode&quot;" />
  </Target>
  <Target Name="MakePublishedOsslSignCodeExecutable" AfterTargets="Publish" Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(RuntimeIdentifier)' != 'win-x64'">
    <Exec Command="chmod +x &quot;$(PublishDir)tools/osslsigncode/osslsigncode&quot;" />
  </Target>
</Project>
